# ---- Database (required) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sensei

# ---- Auth: Clerk (optional — without it the app runs in local demo mode) ----
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---- LiveKit (required for the real voice classroom) ----
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=API...
# LIVEKIT_API_SECRET=...

# ---- Voice model: gemini (default) | openai ----
VOICE_PROVIDER=gemini
# GOOGLE_API_KEY=...            # Gemini Live API + session summaries
# GEMINI_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_VOICE=Aoede
# OPENAI_API_KEY=sk-...         # when VOICE_PROVIDER=openai
# OPENAI_REALTIME_MODEL=gpt-realtime

# ---- Avatar: liveavatar (HeyGen LiveAvatar) | none (default) ----
AVATAR_PROVIDER=none
# LIVEAVATAR_API_KEY=...
# LIVEAVATAR_AVATAR_ID=...
# LIVEAVATAR_SANDBOX=false

# ---- Limits (avatar / realtime voice are billed per minute) ----
MAX_SESSION_MINUTES=15
DAILY_MINUTE_LIMIT=30
